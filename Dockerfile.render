# Single-container image for Render's free web service: MongoDB and the app together.
# Data is ephemeral (reseeded on every start), which suits a test target. Local
# development and CI still use the plain Dockerfile with docker-compose.

FROM node:20-slim AS deps
WORKDIR /usr/src/app
COPY package*.json ./
RUN npm ci --omit=dev

FROM mongo:7
COPY --from=node:20-slim /usr/local/bin/node /usr/local/bin/node

ENV NODE_ENV=production \
    MONGODB_URI=mongodb://127.0.0.1:27017

WORKDIR /usr/src/app
COPY --from=deps /usr/src/app/node_modules ./node_modules
COPY . .
RUN chmod +x scripts/render-start.sh

EXPOSE 3000

# The mongo base image's entrypoint would start mongod itself; the script runs it.
ENTRYPOINT []
CMD ["scripts/render-start.sh"]
