<header id="main-header"<%= locals.isAdmin ? ' class=is-admin' : '' %>>
  <button type="button" id="mobile-menu-btn" aria-expanded="false" aria-controls="site-nav" aria-label="<%= t('nav.menu') %>">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <div id="logo"><a href="/">WDE</a></div>

  <% if (!locals.isAdmin) { %>
    <div id="product-search-container" role="search">
      <label for="product-search" class="sr-only"><%= t('products.searchLabel') %></label>
      <%- include('icon', { name: 'search' }) %>
      <input
        type="text"
        id="product-search"
        role="combobox"
        aria-expanded="false"
        aria-controls="product-search-results"
        aria-autocomplete="list"
        autocomplete="off"
        placeholder="<%= t('products.searchPlaceholder') %>"
      >
      <ul id="product-search-results" role="listbox" hidden></ul>
    </div>

    <a id="cart-link" href="/cart">
      <%- include('icon', { name: 'cart' }) %>
      <span class="sr-only"><%= t('nav.cart') %></span>
      <span class="cart-count"><%= locals.cart.totalQuantity %></span>
    </a>
  <% } %>

  <nav id="site-nav" aria-label="<%= t('nav.mainNavigation') %>">
    <ul class="nav-items">
      <% if (!locals.isAdmin) { %>
        <li><a href="/products"><%= t('nav.shop') %></a></li>
      <% } else { %>
        <li><a href="/admin/products"><%= t('nav.adminMenu') %></a></li>
        <li>
          <form action="/logout" method="POST">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
            <button class="btn btn-alt"><%= t('nav.logout') %></button>
          </form>
        </li>
      <% } %>

      <% if (!locals.isAuth) { %>
        <li><a href="/login"><%= t('nav.login') %></a></li>
        <li><a class="btn" href="/signup"><%= t('nav.signup') %></a></li>
      <% } else if (!locals.isAdmin) { %>
        <li class="dropdown">
          <button type="button" class="dropdown-trigger" aria-haspopup="true" aria-expanded="false">
            <%- include('icon', { name: 'user' }) %>
            <span><%= t('nav.account') %></span>
          </button>
          <ul class="dropdown-menu" hidden>
            <li><a class="dropdown-item" href="/orders"><%= t('nav.orders') %></a></li>
            <li>
              <form action="/logout" method="POST">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                <button class="dropdown-item"><%= t('nav.logout') %></button>
              </form>
            </li>
          </ul>
        </li>
      <% } %>

      <li class="dropdown">
        <button
          type="button"
          class="dropdown-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="<%= t('nav.languageLabel') %>"
        >
          <%- include('flag-' + locals.lang) %>
          <span class="lang-code"><%= locals.lang.toUpperCase() %></span>
        </button>
        <ul class="dropdown-menu" hidden>
          <li>
            <a href="/lang/en" class="dropdown-item<%= locals.lang === 'en' ? ' active' : '' %>">
              <%- include('flag-en') %>
              <span>EN</span>
            </a>
          </li>
          <li>
            <a href="/lang/pt" class="dropdown-item<%= locals.lang === 'pt' ? ' active' : '' %>">
              <%- include('flag-pt') %>
              <span>PT</span>
            </a>
          </li>
        </ul>
      </li>

      <li class="dropdown">
        <button
          type="button"
          class="dropdown-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="<%= t('nav.theme') %>"
        >
          <%- include('icon', { name: 'theme' }) %>
          <span class="dropdown-label"><%= t('nav.theme') %></span>
        </button>
        <ul class="dropdown-menu" hidden>
          <% for (const choice of ['system', 'light', 'dark']) { %>
            <li>
              <button
                type="button"
                class="dropdown-item"
                data-theme-choice="<%= choice %>"
                aria-pressed="<%= (locals.theme || 'system') === choice %>"
              ><%= t('nav.theme' + choice.charAt(0).toUpperCase() + choice.slice(1)) %></button>
            </li>
          <% } %>
        </ul>
      </li>
    </ul>
  </nav>
</header>
