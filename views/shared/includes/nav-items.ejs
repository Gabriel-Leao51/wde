<ul class="nav-items">
  <% if (!locals.isAdmin) { %>
    <li><a href="/"><%= t('nav.shop') %></a></li>
    <li><a href="/cart"><%= t('nav.cart') %> <span class="badge"><%= locals.cart.totalQuantity %></span></a></li>
  <% } %>

  <% if (locals.isAuth && !locals.isAdmin) { %>
    <li><a href="/orders"><%= t('nav.orders') %></a></li>
  <% } %>

  <% if (locals.isAdmin) { %>
    <li><a href="/admin/products"><%= t('nav.manageProducts') %></a></li>
    <li><a href="/admin/orders"><%= t('nav.manageOrders') %></a></li>
  <% } %>

  <% if (!locals.isAuth) { %>
    <li><a href="/signup"><%= t('nav.signup') %></a></li>
    <li><a href="/login"><%= t('nav.login') %></a></li>
  <% } %>

  <% if (locals.isAuth) { %>
    <li>
      <form action="/logout" method="POST">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
        <button><%= t('nav.logout') %></button>
      </form>
    </li>
  <% } %>

  <li class="lang-switcher">
    <button
      type="button"
      class="lang-trigger"
      aria-haspopup="true"
      aria-expanded="false"
      aria-label="<%= t('nav.languageLabel') %>"
    >
      <%- include('flag-' + locals.lang) %>
      <span class="lang-code"><%= locals.lang.toUpperCase() %></span>
    </button>
    <ul class="lang-menu" hidden>
      <li>
        <a href="/lang/en" class="lang-option<%= locals.lang === 'en' ? ' active' : '' %>">
          <%- include('flag-en') %>
          <span>EN</span>
        </a>
      </li>
      <li>
        <a href="/lang/pt" class="lang-option<%= locals.lang === 'pt' ? ' active' : '' %>">
          <%- include('flag-pt') %>
          <span>PT</span>
        </a>
      </li>
    </ul>
  </li>
</ul>