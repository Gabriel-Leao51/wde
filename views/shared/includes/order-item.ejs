<article class="order-item">
  <% const statusKey = 'orders.status' + order.status.charAt(0).toUpperCase() + order.status.slice(1); %>
  <header class="order-summary">
    <div class="order-heading">
      <h2><%= t('orders.orderNumber') %><%= order.id.toString().slice(-6).toUpperCase() %></h2>
      <p class="order-date"><%= order.formattedDate %></p>
    </div>
    <span class="badge badge-<%= order.status %>"><%= t(statusKey).toUpperCase() %></span>
  </header>

  <section class="order-details">
    <% if (locals.isAdmin) { %>
      <address>
        <p><a href="mailto:<%= order.userData.email %>"><%= order.userData.name %></a></p>
        <p><%= order.userData.address.street %> (<%= order.userData.address.postalCode %> <%= order.userData.address.city %>)</p>
      </address>
    <% } %>
    <ul class="order-lines">
      <% for (const item of order.productData.items) { %>
        <li class="order-line">
          <img class="order-line-thumb" src="<%= item.product.imageUrl %>" alt="<%= item.product.title %>">
          <div class="order-line-info">
            <a href="/products/<%= item.product.id %>"><%= item.product.title %></a>
            <span class="order-line-each">$<%= item.product.price.toFixed(2) %> x <%= item.quantity %></span>
          </div>
          <span class="order-line-total">$<%= item.totalPrice.toFixed(2) %></span>
        </li>
      <% } %>
    </ul>
  </section>

  <footer class="order-footer">
    <p class="order-total"><%= t('orders.total') %> <span class="order-item-price">$<%= order.productData.totalPrice.toFixed(2) %></span></p>
    <% if (!locals.isAdmin) { %>
      <a class="btn btn-alt" href="/orders/<%= order.id %>/invoice.pdf"><%= t('orders.downloadInvoice') %></a>
    <% } %>
  </footer>

  <% if (locals.isAdmin) { %>
    <section class="order-actions">
      <form>
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
        <input type="hidden" name="orderid" value="<%= order.id %>">
        <select name="status">
          <option value="pending" <% if (order.status === 'pending') { %>selected<% } %>><%= t('orders.statusPending') %></option>
          <option value="fulfilled" <% if (order.status === 'fulfilled') { %>selected<% } %>><%= t('orders.statusFulfilled') %></option>
          <option value="cancelled" <% if (order.status === 'cancelled') { %>selected<% } %>><%= t('orders.statusCancelled') %></option>
        </select>
        <button class="btn btn-alt"><%= t('orders.update') %></button>
      </form>
    </section>
  <% } %>
</article>
