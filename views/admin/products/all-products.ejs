<%- include('../../shared/includes/head', { pageTitle: t('products.allProductsTitle') }) %>
<link rel="stylesheet" href="/styles/products.css">
<script src="/scripts/product-management.js" defer></script>
</head>
<body>
  <%- include('../../shared/includes/header') %>
  <main>
    <h1><%= t('products.productAdministrationTitle') %></h1>
    <section>
      <h2><%= t('products.manageProductsHeading') %></h2>
      <p>
        <a href="/admin/products/new" class="btn"><%= t('products.addProduct') %></a>
      </p>
    </section>
    <section>
      <ul id="products-grid">
        <% for (const product of products) { %>
          <li>
            <%- include('../../shared/includes/product-item', { product: product }) %>
          </li>
        <% } %>
      </ul>
    </section>
    <dialog id="delete-confirm-dialog">
      <p><%= t('products.deleteConfirmMessage') %> "<span id="delete-confirm-product-name"></span>"?</p>
      <div class="dialog-actions">
        <button type="button" id="delete-cancel-button" class="btn btn-alt"><%= t('products.cancel') %></button>
        <button type="button" id="delete-confirm-button" class="btn"><%= t('products.delete') %></button>
      </div>
    </dialog>
  </main>
<%- include('../../shared/includes/footer') %>