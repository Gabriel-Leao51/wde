<table id="orders-table">
  <thead>
    <tr>
      <th data-sort="date" data-sort-type="date"><%= t('orders.dateColumn') %></th>
      <th data-sort="customer" data-sort-type="text"><%= t('orders.customerColumn') %></th>
      <th><%= t('orders.itemsColumn') %></th>
      <th data-sort="total" data-sort-type="number"><%= t('orders.totalColumn') %></th>
      <th data-sort="status" data-sort-type="text"><%= t('orders.statusColumn') %></th>
      <th><%= t('orders.actionsColumn') %></th>
    </tr>
  </thead>
  <tbody>
    <% for (const order of orders) { %>
      <%- include('order-table-row', { order: order }) %>
    <% } %>
  </tbody>
</table>
