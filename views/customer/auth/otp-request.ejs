<%- include('../../shared/includes/head', { pageTitle: t('auth.otpRequestTitle') }) %>
  <link rel="stylesheet" href="/styles/forms.css">
  <link rel="stylesheet" href="/styles/auth.css">
  <script src="/scripts/auth-validation.js" defer></script>
</head>
<body>
  <%- include('../../shared/includes/header') %>
  <main class="auth-page">
    <section class="auth-card" aria-labelledby="auth-heading">
      <h1 id="auth-heading"><%= t('auth.otpRequestHeading') %></h1>
      <p class="auth-intro"><%= t('auth.otpRequestInstructions') %></p>
      <% if (inputData.errorMessage) { %>
        <section class="alert">
          <h2><%= t('auth.invalidInputHeading') %></h2>
          <p><%= inputData.errorMessage %></p>
        </section>
      <% } %>
      <%- include('includes/validation-messages') %>
      <form action="/login/otp/request" method="POST" data-validate>
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
        <div class="field">
          <label for="email"><%= t('auth.emailLabel') %></label>
          <input type="email" id="email" name="email" autocomplete="email" value="<%= inputData.email %>" required>
          <p class="field-error" id="email-error" hidden></p>
        </div>
        <button class="btn"><%= t('auth.otpSendCodeButton') %></button>
      </form>
      <p class="auth-links">
        <a id="switch-form" href="/login"><%= t('auth.otpBackToPasswordLogin') %></a>
      </p>
    </section>
  </main>
<%- include('../../shared/includes/footer') %>
