<%- include('../../shared/includes/head', { pageTitle: t('auth.loginTitle') }) %>
  <link rel="stylesheet" href="/styles/forms.css">
  <link rel="stylesheet" href="/styles/auth.css">
  <script src="/scripts/auth-validation.js" defer></script>
</head>
<body>
  <%- include('../../shared/includes/header') %>
  <main class="auth-page">
    <section class="auth-card" aria-labelledby="auth-heading">
      <h1 id="auth-heading"><%= t('auth.loginHeading') %></h1>
      <% if (inputData.errorMessage) { %>
        <section class="alert">
          <h2><%= t('auth.invalidCredentialsHeading') %></h2>
          <p><%= inputData.errorMessage %></p>
        </section>
      <% } %>
      <%- include('includes/validation-messages') %>
      <form action="/login" method="POST" data-validate>
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
        <div class="field">
          <label for="email"><%= t('auth.emailLabel') %></label>
          <input type="email" id="email" name="email" autocomplete="email" value="<%= inputData.email %>" required>
          <p class="field-error" id="email-error" hidden></p>
        </div>
        <div class="field">
          <label for="password"><%= t('auth.passwordLabel') %></label>
          <input type="password" id="password" name="password" autocomplete="current-password" value="<%= inputData.password %>" required>
          <p class="field-error" id="password-error" hidden></p>
        </div>
        <button class="btn"><%= t('auth.loginHeading') %></button>
      </form>
      <p class="auth-links">
        <a id="switch-form" href="/signup"><%= t('auth.createNewUser') %></a>
        <a id="otp-login-link" href="/login/otp"><%= t('auth.otpLoginLink') %></a>
      </p>
    </section>
  </main>
<%- include('../../shared/includes/footer') %>
