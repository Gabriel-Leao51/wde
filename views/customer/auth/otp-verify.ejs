<%- include('../../shared/includes/head', { pageTitle: t('auth.otpVerifyTitle') }) %>
  <link rel="stylesheet" href="/styles/forms.css">
  <link rel="stylesheet" href="/styles/auth.css">
  <script src="/scripts/auth-validation.js" defer></script>
</head>
<body>
  <%- include('../../shared/includes/header') %>
  <main class="auth-page">
    <section class="auth-card" aria-labelledby="auth-heading">
      <h1 id="auth-heading"><%= t('auth.otpVerifyHeading') %></h1>
      <p class="auth-intro"><%= t('auth.otpVerifyInstructions') %></p>
      <% if (inputData.errorMessage) { %>
        <section class="alert">
          <h2><%= t('auth.invalidInputHeading') %></h2>
          <p><%= inputData.errorMessage %></p>
        </section>
      <% } %>
      <%- include('includes/validation-messages') %>
      <form action="/login/otp/verify" method="POST" data-validate>
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
        <input type="hidden" name="email" value="<%= inputData.email %>">
        <div class="field">
          <label for="code"><%= t('auth.otpCodeLabel') %></label>
          <input
            type="text"
            id="code"
            name="code"
            inputmode="numeric"
            pattern="[0-9]{6}"
            maxlength="6"
            autocomplete="one-time-code"
            value="<%= inputData.code %>"
            required>
          <p class="field-error" id="code-error" hidden></p>
        </div>
        <button class="btn"><%= t('auth.otpVerifyButton') %></button>
      </form>
      <p class="auth-links">
        <a id="switch-form" href="/login/otp"><%= t('auth.otpRequestNewCode') %></a>
      </p>
    </section>
  </main>
<%- include('../../shared/includes/footer') %>
