<%- include('../../shared/includes/head', { pageTitle: t('products.allProductsTitle') }) %>
<link rel="stylesheet" href="/styles/products.css">
<script src="/scripts/product-search.js" defer></script>
</head>
<body>
  <%- include('../../shared/includes/header') %>
  <main>
    <h1><%= t('products.allProductsTitle') %></h1>
    <div id="product-search-container" role="search">
      <label for="product-search"><%= t('products.searchLabel') %></label>
      <input
        type="text"
        id="product-search"
        role="combobox"
        aria-expanded="false"
        aria-controls="product-search-results"
        aria-autocomplete="list"
        autocomplete="off"
        placeholder="<%= t('products.searchPlaceholder') %>"
      >
      <ul id="product-search-results" role="listbox" hidden></ul>
    </div>
    <form id="catalog-filters" method="GET" action="/products">
      <label for="department-filter">
        <%= t('products.filterByDepartment') %>
        <select id="department-filter" name="department">
          <option value="" <% if (!selectedDepartment) { %>selected<% } %>><%= t('products.allDepartments') %></option>
          <% for (const department of departments) { %>
            <option value="<%= department %>" <% if (selectedDepartment === department) { %>selected<% } %>><%= t('departments.' + department) %></option>
          <% } %>
        </select>
      </label>
      <label for="sort-select">
        <%= t('products.sortBy') %>
        <select id="sort-select" name="sort">
          <option value="" <% if (!selectedSort) { %>selected<% } %>><%= t('products.sortDefault') %></option>
          <option value="name_asc" <% if (selectedSort === 'name_asc') { %>selected<% } %>><%= t('products.sortNameAsc') %></option>
          <option value="name_desc" <% if (selectedSort === 'name_desc') { %>selected<% } %>><%= t('products.sortNameDesc') %></option>
          <option value="price_asc" <% if (selectedSort === 'price_asc') { %>selected<% } %>><%= t('products.sortPriceAsc') %></option>
          <option value="price_desc" <% if (selectedSort === 'price_desc') { %>selected<% } %>><%= t('products.sortPriceDesc') %></option>
        </select>
      </label>
      <button type="submit" class="btn"><%= t('products.applyFilters') %></button>
    </form>
    <ul id="products-grid">
      <% for (const product of products) { %>
        <li>
          <%- include('../../shared/includes/product-item', { product: product }) %>
        </li>
      <% } %>
    </ul>
  </main>
<%- include('../../shared/includes/footer') %>