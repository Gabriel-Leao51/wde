<%- include('../../shared/includes/head', { pageTitle: product.title }) %>
<link rel="stylesheet" href="/styles/products.css">
<script src="/scripts/cart-management.js" defer></script>
</head>
<body>
  <%- include('../../shared/includes/header') %>
  <main id="product-details">
    <nav id="breadcrumbs" aria-label="<%= t('products.breadcrumbLabel') %>">
      <ol>
        <li><a href="/"><%= t('products.breadcrumbHome') %></a></li>
        <% if (product.department) { %>
          <li><a href="/products?department=<%= encodeURIComponent(product.department) %>"><%= t('departments.' + product.department) %></a></li>
        <% } %>
        <li><span aria-current="page"><%= product.title %></span></li>
      </ol>
    </nav>
    <section id="product-overview">
      <img src="<%= product.imageUrl %>" alt="<%= product.title %>">
      <div id="product-info">
        <h1><%= product.title %></h1>
        <p id="product-price">$<%= product.price.toFixed(2) %></p>
        <% if (product.summary) { %>
          <p id="product-summary"><%= product.summary %></p>
        <% } %>
        <% if (product.launchDate) { %>
          <p id="product-launch-date"><%= t('products.availableSince') %> <%= product.launchDate.toLocaleDateString('en-US', { dateStyle: 'long' }) %></p>
        <% } %>
        <button class="btn btn-buy" data-productid="<%= product.id %>" data-csrf="<%= locals.csrfToken %>"><%= t('products.addToCart') %></button>
      </div>
    </section>

    <div id="product-description"><%- product.description %></div>

    <% if (relatedProducts.length > 0) { %>
      <section id="related-products" aria-labelledby="related-heading">
        <h2 id="related-heading"><%= t('products.relatedHeading') %></h2>
        <ul id="products-grid">
          <% for (const related of relatedProducts) { %>
            <li>
              <%- include('../../shared/includes/product-item', { product: related }) %>
            </li>
          <% } %>
        </ul>
      </section>
    <% } %>
  </main>
<%- include('../../shared/includes/footer') %>
