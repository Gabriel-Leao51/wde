<article class="cart-item">
  <button
    type="button"
    class="remove-item-btn"
    data-productid="<%= item.product.id %>"
    data-csrf="<%= locals.csrfToken %>"
  ><%= t('cart.removeItem') %></button>

  <div class="cart-item-info">
    <h2><%= item.product.title %></h2>
    <p>$<span class="cart-item-price"><%= item.totalPrice.toFixed(2) %></span> <span class="cart-product-price">($<%= item.product.price.toFixed(2) %>)</span></p>
  </div>

  <div class="cart-item-management" data-productid="<%= item.product.id %>" data-csrf="<%= locals.csrfToken %>">
    <button
      type="button"
      class="quantity-btn quantity-decrease"
      aria-label="<%= t('cart.decreaseQuantity') %>"
      <% if (item.quantity === 1) { %>disabled<% } %>
    >&minus;</button>
    <span class="quantity-label" data-quantity="<%= item.quantity %>"><%= item.quantity %></span>
    <button
      type="button"
      class="quantity-btn quantity-increase"
      aria-label="<%= t('cart.increaseQuantity') %>"
    >&plus;</button>
  </div>
</article>
